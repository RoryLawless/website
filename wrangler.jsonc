{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "website",
    "compatibility_date": "2026-04-30",
    "assets": {
        "directory": "./_site",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
    },
    "routes": [
        {
            "pattern": "rorylawless.com",
            "custom_domain": true
        }
    ]
}
